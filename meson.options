option('sdl',
  type: 'feature',
  value: 'auto',
  description: 'SDL 1.2 graphical display support')

option('haiku_gui',
  type: 'feature',
  value: 'auto',
  description: 'native Haiku window instead of SDL (Haiku hosts only)')

option('win32_gui',
  type: 'feature',
  value: 'auto',
  description: 'native Win32 window instead of SDL (Windows hosts only)')

option('fs_net',
  type: 'feature',
  value: 'disabled',
  description: 'network filesystem support (requires libcurl and libcrypto)')

option('builtin_crypto',
  type: 'boolean',
  value: false,
  description: 'use the bundled AES/SHA256 code instead of libcrypto')

option('x86emu',
  type: 'boolean',
  value: true,
  description: 'build the x86 emulator')

option('whp',
  type: 'feature',
  value: 'auto',
  description: 'run the x86 machine on the Windows Hypervisor Platform (Windows x86-64 hosts only)')

option('nvmm',
  type: 'feature',
  value: 'auto',
  description: 'run the x86 machine on NVMM (Haiku x86-64 hosts only)')

option('slirp',
  type: 'boolean',
  value: true,
  description: 'build the user space network redirector')

option('int128',
  type: 'boolean',
  value: false,
  description: 'build the 128 bit RISC-V emulator (needs __int128)')
