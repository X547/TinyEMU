# 32 bit x86 image booted through PVH: flat protected mode, no paging.
# General registers only, so nothing has to turn SSE on.

[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
strip = 'llvm-strip'

[host_machine]
system = 'none'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'

[properties]
needs_exe_wrapper = true

[constants]
target = ['--target=i686-unknown-none-elf', '-mgeneral-regs-only', '-fno-pic']

[built-in options]
c_args = target + ['-nostdlibinc']
cpp_args = target + ['-nostdlibinc']
c_link_args = target + ['-fuse-ld=lld', '-nostdlib']
cpp_link_args = target + ['-fuse-ld=lld', '-nostdlib']
