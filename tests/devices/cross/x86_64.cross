# x86_64 image booted through PVH: it enters long mode itself, with the
# low 4 GB identity mapped. General registers only, so nothing has to turn
# SSE on, and no red zone, since traps arrive on the same stack.

[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
strip = 'llvm-strip'

[host_machine]
system = 'none'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
needs_exe_wrapper = true

[constants]
target = ['--target=x86_64-unknown-none-elf', '-mgeneral-regs-only', '-mno-red-zone', '-fno-pic']

[built-in options]
c_args = target + ['-nostdlibinc']
cpp_args = target + ['-nostdlibinc']
c_link_args = target + ['-fuse-ld=lld', '-nostdlib']
cpp_link_args = target + ['-fuse-ld=lld', '-nostdlib']
